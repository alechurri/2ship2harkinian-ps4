diff --git a/mm/2s2h/port/ps4/Ps4Breadcrumbs.cpp b/mm/2s2h/port/ps4/Ps4Breadcrumbs.cpp
new file mode 100644
index 0000000..dafc326
--- /dev/null
+++ b/mm/2s2h/port/ps4/Ps4Breadcrumbs.cpp
@@ -0,0 +1,42 @@
+// PS4: progress markers in the log. When the system ends the process without a report (out of
+// memory, GPU fault), the last marker says how far the game got.
+
+#ifdef __PS4__
+
+#include "2s2h/GameInteractor/GameInteractor.h"
+#include "2s2h/ShipInit.hpp"
+
+#include <ship/port/ps4/Ps4Platform.h>
+#include <spdlog/spdlog.h>
+
+namespace {
+bool sSceneFrameLogged = true;
+
+void RegisterPs4Breadcrumbs() {
+    GameInteractor::Instance->RegisterGameHook<GameInteractor::OnFileSelectSaveLoad>(
+        [](s16 fileNum, bool isOwlSave, SaveContext*) {
+            SPDLOG_INFO("[PS4] file select: save {} loaded{}", fileNum, isOwlSave ? " (owl save)" : "");
+        });
+    GameInteractor::Instance->RegisterGameHook<GameInteractor::OnSaveLoad>(
+        [](s16 fileNum) { SPDLOG_INFO("[PS4] save {} applied", fileNum); });
+    GameInteractor::Instance->RegisterGameHook<GameInteractor::OnSceneInit>([](s8 sceneId, s8 spawnNum) {
+        SPDLOG_INFO("[PS4] scene {} init (spawn {})", (int)sceneId, (int)spawnNum);
+        Ship::Ps4::LogMemoryStats("at scene init");
+        sSceneFrameLogged = false;
+    });
+    GameInteractor::Instance->RegisterGameHook<GameInteractor::OnRoomInit>(
+        [](s8 sceneId, s8 roomNum) { SPDLOG_INFO("[PS4] room {} of scene {} init", (int)roomNum, (int)sceneId); });
+    GameInteractor::Instance->RegisterGameHook<GameInteractor::OnGameStateDrawFinish>([]() {
+        if (!sSceneFrameLogged) {
+            sSceneFrameLogged = true;
+            SPDLOG_INFO("[PS4] first frame of the scene drawn");
+        }
+    });
+    GameInteractor::Instance->RegisterGameHook<GameInteractor::OnPlayDestroy>(
+        []() { SPDLOG_INFO("[PS4] play state destroyed"); });
+}
+
+RegisterShipInitFunc sInit(RegisterPs4Breadcrumbs, {});
+} // namespace
+
+#endif // __PS4__
diff --git a/mm/2s2h/port/ps4/Ps4Compat.c b/mm/2s2h/port/ps4/Ps4Compat.c
new file mode 100644
index 0000000..d82af8a
--- /dev/null
+++ b/mm/2s2h/port/ps4/Ps4Compat.c
@@ -0,0 +1,66 @@
+// PS4: runtime bits the OpenOrbis C library doesn't provide.
+
+#ifdef __PS4__
+
+#include <pthread.h>
+#include <stdlib.h>
+
+// libc++abi forwards the registration of thread_local destructors to the C library.
+// This is the usual implementation on top of a pthread key: destructors run when the thread
+// exits, and from an atexit handler for the thread that calls exit().
+
+typedef void (*Ps4ThreadDtor)(void*);
+
+typedef struct Ps4ThreadDtorEntry {
+    Ps4ThreadDtor destructor;
+    void* object;
+    struct Ps4ThreadDtorEntry* next;
+} Ps4ThreadDtorEntry;
+
+static pthread_key_t sDtorKey;
+static pthread_once_t sDtorKeyOnce = PTHREAD_ONCE_INIT;
+
+static void Ps4RunThreadDtors(void* list) {
+    Ps4ThreadDtorEntry* entry = (Ps4ThreadDtorEntry*)list;
+    while (entry != NULL) {
+        Ps4ThreadDtorEntry* next = entry->next;
+        entry->destructor(entry->object);
+        free(entry);
+        entry = next;
+    }
+}
+
+static void Ps4RunExitingThreadDtors(void) {
+    // A destructor may register new ones, keep going until the list stays empty.
+    for (int i = 0; i < 8; i++) {
+        void* list = pthread_getspecific(sDtorKey);
+        if (list == NULL) {
+            break;
+        }
+        pthread_setspecific(sDtorKey, NULL);
+        Ps4RunThreadDtors(list);
+    }
+}
+
+static void Ps4CreateDtorKey(void) {
+    pthread_key_create(&sDtorKey, Ps4RunThreadDtors);
+    atexit(Ps4RunExitingThreadDtors);
+}
+
+int __cxa_thread_atexit_impl(Ps4ThreadDtor destructor, void* object, void* dsoHandle) {
+    (void)dsoHandle;
+
+    pthread_once(&sDtorKeyOnce, Ps4CreateDtorKey);
+
+    Ps4ThreadDtorEntry* entry = (Ps4ThreadDtorEntry*)malloc(sizeof(Ps4ThreadDtorEntry));
+    if (entry == NULL) {
+        return -1;
+    }
+    entry->destructor = destructor;
+    entry->object = object;
+    entry->next = (Ps4ThreadDtorEntry*)pthread_getspecific(sDtorKey);
+    pthread_setspecific(sDtorKey, entry);
+    return 0;
+}
+
+#endif // __PS4__
diff --git a/mm/2s2h/port/ps4/Ps4Heap.c b/mm/2s2h/port/ps4/Ps4Heap.c
new file mode 100644
index 0000000..02349aa
--- /dev/null
+++ b/mm/2s2h/port/ps4/Ps4Heap.c
@@ -0,0 +1,266 @@
+// PS4: give the C heap its own big block of memory.
+//
+// The C library (musl) gets all of its heap from anonymous mmap() calls. On PS4 those are served
+// from the application's "flexible memory", a pool of only ~255 MiB that Piglet also keeps its
+// textures in. mmap()/munmap() are therefore replaced here: anonymous read/write mappings are
+// carved out of one arena, everything else is forwarded to the kernel.
+//
+// The arena comes from, in order of preference:
+//  1. system flexible memory (a separate pool this kind of application may map, the same thing
+//     the Super Mario 64 port does), which leaves all of the direct memory to Piglet;
+//  2. direct memory, of which the application only has 768 MiB in total.
+
+#ifdef __PS4__
+
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/types.h>
+
+#include <orbis/libkernel.h>
+
+#define PS4_PAGE_SIZE 0x4000ULL
+#define PS4_ARENA_ALIGN 0x200000ULL
+#define PS4_SYSTEM_ARENA_SIZE (1024ULL * 1024 * 1024)
+#define PS4_MAP_FIXED 0x10
+
+// Not (properly) declared by the OpenOrbis headers.
+int32_t Ps4Heap_MapNamedSystemFlexibleMemory(void** address, size_t length, int32_t protection, int32_t flags,
+                                             const char* name) __asm__("sceKernelMapNamedSystemFlexibleMemory");
+// Leaves the rest of the direct memory to Piglet (video memory) and the system libraries.
+#define PS4_ARENA_MAX_SIZE (1024ULL * 1024 * 1024)
+#define PS4_ARENA_MIN_SIZE (256ULL * 1024 * 1024)
+// Allocations of at least this many pages (1 MiB) are placed top-down.
+#define PS4_LARGE_PAGES 64
+
+static uint8_t* sArenaBase = NULL;
+static size_t sArenaPages = 0;
+// One byte per page: 0 = free, 1 = in use. Lives in the first pages of the arena itself.
+static uint8_t* sPageMap = NULL;
+static size_t sSearchHint = 0;
+static size_t sPagesInUse = 0;
+static size_t sPagesInUsePeak = 0;
+static int sInitDone = 0;
+// 0 = none, 1 = system flexible memory, 2 = direct memory
+static int sArenaKind = 0;
+static volatile int sLock = 0;
+
+static void Ps4Heap_Lock(void) {
+    while (__sync_lock_test_and_set(&sLock, 1)) {
+        while (sLock) {
+            __builtin_ia32_pause();
+        }
+    }
+}
+
+static void Ps4Heap_Unlock(void) {
+    __sync_lock_release(&sLock);
+}
+
+static void Ps4Heap_Init(void) {
+    sInitDone = 1;
+
+    const size_t directMemorySize = sceKernelGetDirectMemorySize();
+    size_t size = PS4_SYSTEM_ARENA_SIZE;
+
+    {
+        void* address = NULL;
+        if (sceKernelReserveVirtualRange(&address, size, 0, PS4_PAGE_SIZE) == 0 && address != NULL) {
+            if (Ps4Heap_MapNamedSystemFlexibleMemory(&address, size, ORBIS_KERNEL_PROT_CPU_RW, PS4_MAP_FIXED,
+                                                     "2S2H heap") == 0) {
+                sArenaBase = (uint8_t*)address;
+                sArenaKind = 1;
+            } else {
+                sceKernelMunmap(address, size);
+            }
+        }
+    }
+
+    if (sArenaBase == NULL) {
+        size = PS4_ARENA_MAX_SIZE;
+    }
+
+    while (sArenaBase == NULL && size >= PS4_ARENA_MIN_SIZE) {
+        off_t physicalAddress = 0;
+        // Prefer the top of the physical range: Piglet and the system libraries allocate from the
+        // bottom and some of them are picky about where their memory sits.
+        int32_t allocated = -1;
+        if (directMemorySize > size) {
+            allocated = sceKernelAllocateDirectMemory((off_t)(directMemorySize - size), (off_t)directMemorySize, size,
+                                                      PS4_ARENA_ALIGN, ORBIS_KERNEL_WB_ONION, &physicalAddress);
+        }
+        if (allocated != 0) {
+            allocated = sceKernelAllocateDirectMemory(0, (off_t)directMemorySize, size, PS4_ARENA_ALIGN,
+                                                      ORBIS_KERNEL_WB_ONION, &physicalAddress);
+        }
+        if (allocated == 0) {
+            void* address = NULL;
+            if (sceKernelMapDirectMemory(&address, size, ORBIS_KERNEL_PROT_CPU_RW, 0, physicalAddress,
+                                         PS4_ARENA_ALIGN) == 0) {
+                sArenaBase = (uint8_t*)address;
+                sArenaKind = 2;
+                break;
+            }
+            sceKernelReleaseDirectMemory(physicalAddress, size);
+        }
+        size /= 2;
+    }
+
+    if (sArenaBase == NULL) {
+        return;
+    }
+
+    sArenaPages = size / PS4_PAGE_SIZE;
+    const size_t mapPages = (sArenaPages + PS4_PAGE_SIZE - 1) / PS4_PAGE_SIZE;
+    sPageMap = sArenaBase;
+    memset(sPageMap, 0, mapPages * PS4_PAGE_SIZE);
+    memset(sPageMap, 1, mapPages);
+    sSearchHint = mapPages;
+    sPagesInUse = mapPages;
+    sPagesInUsePeak = mapPages;
+}
+
+static void* Ps4Heap_Alloc(size_t length) {
+    const size_t pages = (length + PS4_PAGE_SIZE - 1) / PS4_PAGE_SIZE;
+    void* result = NULL;
+
+    Ps4Heap_Lock();
+
+    if (!sInitDone) {
+        Ps4Heap_Init();
+    }
+
+    if (sArenaBase != NULL && pages != 0 && pages <= sArenaPages) {
+        size_t first = (size_t)-1;
+
+        if (pages >= PS4_LARGE_PAGES) {
+            // Large blocks (textures, archives, the heap extensions themselves) are taken from the
+            // top of the arena so they don't get interleaved with the small short-lived ones.
+            size_t run = 0;
+            for (size_t i = sArenaPages; i-- > 0;) {
+                if (sPageMap[i] != 0) {
+                    run = 0;
+                    continue;
+                }
+                if (++run == pages) {
+                    first = i;
+                    break;
+                }
+            }
+        } else {
+            // Next fit from the bottom: start where the last search ended, wrap around once.
+            for (int pass = 0; pass < 2 && first == (size_t)-1; pass++) {
+                const size_t start = (pass == 0) ? sSearchHint : 0;
+                const size_t end = (pass == 0) ? sArenaPages : sSearchHint + pages;
+                size_t run = 0;
+
+                for (size_t i = start; i < end && i < sArenaPages; i++) {
+                    if (sPageMap[i] != 0) {
+                        run = 0;
+                        continue;
+                    }
+                    if (++run == pages) {
+                        first = i + 1 - pages;
+                        sSearchHint = i + 1;
+                        break;
+                    }
+                }
+            }
+        }
+
+        if (first != (size_t)-1) {
+            memset(sPageMap + first, 1, pages);
+            sPagesInUse += pages;
+            if (sPagesInUse > sPagesInUsePeak) {
+                sPagesInUsePeak = sPagesInUse;
+            }
+            result = sArenaBase + first * PS4_PAGE_SIZE;
+        }
+    }
+
+    Ps4Heap_Unlock();
+
+    if (result != NULL) {
+        // Anonymous mappings are guaranteed to read back as zero (calloc relies on it).
+        memset(result, 0, pages * PS4_PAGE_SIZE);
+    }
+
+    return result;
+}
+
+static int Ps4Heap_Contains(const void* address) {
+    return sArenaBase != NULL && (const uint8_t*)address >= sArenaBase &&
+           (const uint8_t*)address < sArenaBase + sArenaPages * PS4_PAGE_SIZE;
+}
+
+int Ps4Heap_IsInArena(const void* address) {
+    return Ps4Heap_Contains(address);
+}
+
+void* Ps4Heap_GetArenaBase(void) {
+    return sArenaBase;
+}
+
+static void Ps4Heap_Free(void* address, size_t length) {
+    const size_t first = (size_t)((uint8_t*)address - sArenaBase) / PS4_PAGE_SIZE;
+    size_t pages = (length + PS4_PAGE_SIZE - 1) / PS4_PAGE_SIZE;
+
+    Ps4Heap_Lock();
+    if (first + pages > sArenaPages) {
+        pages = sArenaPages - first;
+    }
+    for (size_t i = first; i < first + pages; i++) {
+        if (sPageMap[i] != 0) {
+            sPageMap[i] = 0;
+            sPagesInUse--;
+        }
+    }
+    Ps4Heap_Unlock();
+}
+
+void* mmap(void* address, size_t length, int protection, int flags, int fd, off_t offset) {
+    if (address == NULL && fd == -1 && (flags & MAP_ANON) != 0 && (flags & MAP_FIXED) == 0 &&
+        protection == (PROT_READ | PROT_WRITE)) {
+        void* result = Ps4Heap_Alloc(length);
+        if (result != NULL) {
+            return result;
+        }
+    }
+
+    void* mapped = NULL;
+    const int32_t result = sceKernelMmap(address, length, protection, flags, fd, offset, &mapped);
+    if (result < 0) {
+        errno = ENOMEM;
+        return MAP_FAILED;
+    }
+    return mapped;
+}
+
+int munmap(void* address, size_t length) {
+    if (Ps4Heap_Contains(address)) {
+        Ps4Heap_Free(address, length);
+        return 0;
+    }
+
+    if (sceKernelMunmap(address, length) < 0) {
+        errno = EINVAL;
+        return -1;
+    }
+    return 0;
+}
+
+// 0 = no arena (plain mmap), 1 = system flexible memory, 2 = direct memory
+int Ps4Heap_GetKind(void) {
+    return sArenaKind;
+}
+
+// For the log: how much of the arena is (and was at most) in use, in bytes.
+void Ps4Heap_GetStats(size_t* arenaSize, size_t* inUse, size_t* peak) {
+    *arenaSize = sArenaPages * PS4_PAGE_SIZE;
+    *inUse = sPagesInUse * PS4_PAGE_SIZE;
+    *peak = sPagesInUsePeak * PS4_PAGE_SIZE;
+}
+
+#endif // __PS4__
diff --git a/mm/2s2h/port/ps4/Ps4Main.cpp b/mm/2s2h/port/ps4/Ps4Main.cpp
new file mode 100644
index 0000000..a26f8bc
--- /dev/null
+++ b/mm/2s2h/port/ps4/Ps4Main.cpp
@@ -0,0 +1,389 @@
+// PS4 process entry point.
+
+#ifdef __PS4__
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <orbis/SystemService.h>
+#include <orbis/libkernel.h>
+
+#include <spdlog/spdlog.h>
+#include <ship/port/ps4/Ps4Platform.h>
+
+#include <atomic>
+#include <exception>
+#include <stdexcept>
+#include <string>
+
+extern "C" int ship_main(int argc, char* argv[]);
+// Not declared by the OpenOrbis headers.
+extern "C" int sceKernelInstallExceptionHandler(int signalNumber, void (*handler)(int, void*));
+extern "C" int sceKernelRemoveExceptionHandler(int signalNumber);
+extern "C" int sceKernelRaiseException(pthread_t thread, int signalNumber);
+// From the OpenOrbis linker script.
+extern "C" char __text_start;
+extern "C" char __eh_frame_start;
+extern "C" void Ps4Heap_GetStats(size_t* arenaSize, size_t* inUse, size_t* peak);
+extern "C" int Ps4Heap_IsInArena(const void* address);
+extern "C" void* Ps4Heap_GetArenaBase(void);
+
+namespace {
+// Everything the game reads and writes (ROM archives, saves, config, mods, logs) lives here.
+constexpr const char* kDataDirectory = "/data/2ship";
+// The decompiled game code, the randomizer and std::regex recurse deeper than the default
+// main thread stack is comfortable with.
+constexpr size_t kGameThreadStackSize = 16 * 1024 * 1024;
+
+// The game only opens its log file after the window exists. Until then (and for anything that
+// goes wrong inside the graphics setup) stdout/stderr are the only trace, so they are sent here.
+constexpr const char* kBootLog = "/data/2ship/ps4_boot.log";
+int sBootLogFd = -1;
+
+void BootLogRaw(const char* text) {
+    if (sBootLogFd >= 0) {
+        write(sBootLogFd, text, strlen(text));
+        fsync(sBootLogFd);
+    }
+}
+
+void FatalSignalHandler(int signalNumber, siginfo_t* info, void*) {
+    char line[160];
+    snprintf(line, sizeof(line), "[PS4] FATAL: signal %d, fault address %p\n", signalNumber,
+             info != nullptr ? info->si_addr : nullptr);
+    BootLogRaw(line);
+    signal(signalNumber, SIG_DFL);
+    raise(signalNumber);
+}
+
+// Faults don't reach POSIX signal handlers on this system; the kernel's own exception handler
+// API does. It gets the PS4 ucontext: a 16 byte signal mask and 48 bytes of padding, then a
+// FreeBSD amd64 mcontext. Everything is logged as an offset from the start of the executable's
+// code, which ps4port/symbolize.py turns back into functions with the matching ELF.
+constexpr int kMcontextOffset = 64;
+constexpr int kRipOffset = kMcontextOffset + 160;
+constexpr int kRspOffset = kMcontextOffset + 184;
+constexpr int kRbpOffset = kMcontextOffset + 72;
+constexpr int kAddrOffset = kMcontextOffset + 136;
+// SIGUSR1 in kernel numbering: what sceKernelRaiseException() delivers to another thread.
+constexpr int kHangDumpSignal = 30;
+
+uintptr_t CodeOffset(uintptr_t address) {
+    const uintptr_t start = (uintptr_t)&__text_start;
+    const uintptr_t end = (uintptr_t)&__eh_frame_start;
+    return (address >= start && address < end) ? address - start : 0;
+}
+
+// Highest address of the game thread's stack (approximately: a local of its entry function).
+uintptr_t sGameStackTop = 0;
+
+void LogStackCodeAddresses(const uintptr_t* from, const char* what) {
+    char line[160];
+    snprintf(line, sizeof(line), "[PS4] code addresses on the %s stack (offsets):", what);
+    BootLogRaw(line);
+    // Never read past the top of the game thread's stack: that page isn't mapped.
+    int limit = 1024;
+    if (sGameStackTop > (uintptr_t)from && sGameStackTop - (uintptr_t)from < 0x1000000) {
+        limit = (int)((sGameStackTop - (uintptr_t)from) / sizeof(uintptr_t));
+    }
+    int found = 0;
+    for (int i = 0; i < limit && found < 48; i++) {
+        const uintptr_t offset = CodeOffset(from[i]);
+        if (offset != 0) {
+            snprintf(line, sizeof(line), " %lx", (unsigned long)offset);
+            BootLogRaw(line);
+            found++;
+        }
+    }
+    BootLogRaw("\n");
+}
+
+void KernelExceptionHandler(int signalNumber, void* context) {
+    const bool hangDump = signalNumber == kHangDumpSignal;
+    char line[256];
+    const uint8_t* ctx = static_cast<const uint8_t*>(context);
+    uintptr_t rip = 0;
+    uintptr_t rsp = 0;
+    uintptr_t rbp = 0;
+    uintptr_t addr = 0;
+    if (ctx != nullptr) {
+        memcpy(&rip, ctx + kRipOffset, sizeof(rip));
+        memcpy(&rsp, ctx + kRspOffset, sizeof(rsp));
+        memcpy(&rbp, ctx + kRbpOffset, sizeof(rbp));
+        memcpy(&addr, ctx + kAddrOffset, sizeof(addr));
+    }
+    snprintf(line, sizeof(line),
+             "[PS4] %s: exception %d at rip %p (code offset %lx), fault address %p, rsp %p, rbp %p, text "
+             "start %p\n",
+             hangDump ? "HANG" : "FATAL", signalNumber, (void*)rip, (unsigned long)CodeOffset(rip), (void*)addr, (void*)rsp, (void*)rbp,
+             (void*)&__text_start);
+    BootLogRaw(line);
+    // Walk the frame pointer chain. On the game thread the top of the stack is known; on other
+    // threads (audio...) only follow frames that keep going up in small steps from rsp.
+    const bool onGameStack = sGameStackTop != 0 && rsp != 0 && rsp < sGameStackTop &&
+                             sGameStackTop - rsp < kGameThreadStackSize && (rsp & 7) == 0;
+    const uintptr_t self = (uintptr_t)&rip;
+    const bool onThisStack = rsp != 0 && (rsp & 7) == 0 && rsp > self && rsp - self < 0x10000;
+    if (onGameStack || onThisStack) {
+        const uintptr_t top = onGameStack ? sGameStackTop : rsp + 0x200000;
+        BootLogRaw("[PS4] call chain (offsets):");
+        uintptr_t frame = rbp;
+        for (int depth = 0; depth < 64; depth++) {
+            if (frame < rsp || frame + 16 > top || (frame & 7) != 0) {
+                break;
+            }
+            const uintptr_t* slots = reinterpret_cast<const uintptr_t*>(frame);
+            snprintf(line, sizeof(line), " %lx", (unsigned long)CodeOffset(slots[1]));
+            BootLogRaw(line);
+            if (slots[0] <= frame || slots[0] - frame > 0x20000) {
+                break;
+            }
+            frame = slots[0];
+        }
+        BootLogRaw("\n");
+    }
+    if (onGameStack) {
+        LogStackCodeAddresses(reinterpret_cast<const uintptr_t*>(rsp), "faulting");
+    } else {
+        uintptr_t here = 0;
+        LogStackCodeAddresses(&here, "handler");
+    }
+    if (hangDump) {
+        // Interrupted on purpose by the watchdog: carry on where the thread was.
+        BootLogRaw("[PS4] end of hang report\n");
+        return;
+    }
+    BootLogRaw("[PS4] end of crash report\n");
+    // Let the fault happen again without us, so the system ends the process as usual.
+    sceKernelRemoveExceptionHandler(signalNumber);
+}
+
+// If no frame gets presented for a while, interrupt the game thread so the exception handler
+// logs where it is stuck. A few reports, spaced out, tell a tight loop from a blocked wait.
+pthread_t sGameThread;
+
+void* HangWatchdog(void*) {
+    uint64_t lastCount = 0;
+    int stalledSeconds = 0;
+    int reports = 0;
+    while (reports < 3) {
+        sleep(1);
+        const uint64_t count = Ship::Ps4::GetSwapCount();
+        if (count == 0 || count != lastCount) {
+            lastCount = count;
+            stalledSeconds = 0;
+            continue;
+        }
+        stalledSeconds++;
+        if (stalledSeconds == 6 || stalledSeconds == 12 || stalledSeconds == 20) {
+            char line[160];
+            snprintf(line, sizeof(line), "[PS4] HANG: no frame presented for %d s (frame %llu, %s)\n",
+                     stalledSeconds, (unsigned long long)count,
+                     Ship::Ps4::IsSwapInProgress() ? "inside eglSwapBuffers" : "not swapping");
+            BootLogRaw(line);
+            Ship::Ps4::LogMemoryStats("during the hang");
+            const int result = sceKernelRaiseException(sGameThread, kHangDumpSignal);
+            if (result < 0) {
+                snprintf(line, sizeof(line), "[PS4] sceKernelRaiseException failed: 0x%08X\n", (unsigned int)result);
+                BootLogRaw(line);
+            }
+            reports++;
+        }
+    }
+    return nullptr;
+}
+
+void TerminateHandler() {
+    char line[512];
+    const char* what = "unknown";
+    std::string message;
+    if (std::exception_ptr current = std::current_exception()) {
+        try {
+            std::rethrow_exception(current);
+        } catch (const std::exception& e) {
+            message = e.what();
+            what = message.c_str();
+        } catch (...) {
+        }
+    } else {
+        what = "std::terminate called without an active exception";
+    }
+    snprintf(line, sizeof(line), "[PS4] FATAL: uncaught C++ exception: %s\n", what);
+    BootLogRaw(line);
+    uintptr_t here = 0;
+    LogStackCodeAddresses(&here, "terminate");
+    abort();
+}
+
+// Exceptions go through libunwind's bare-metal mode here; check once that they actually work.
+void CheckExceptions() {
+    bool caught = false;
+    try {
+        throw std::runtime_error("self test");
+    } catch (const std::exception& e) {
+        caught = strcmp(e.what(), "self test") == 0;
+    }
+    BootLogRaw(caught ? "[PS4] C++ exceptions: ok\n" : "[PS4] C++ exceptions: BROKEN\n");
+}
+
+void InstallBootLog() {
+    sBootLogFd = open(kBootLog, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (sBootLogFd >= 0) {
+        // Same descriptor for both streams, so the order of the lines is preserved.
+        dup2(sBootLogFd, STDOUT_FILENO);
+        dup2(sBootLogFd, STDERR_FILENO);
+    }
+    setvbuf(stdout, nullptr, _IONBF, 0);
+    setvbuf(stderr, nullptr, _IONBF, 0);
+
+    spdlog::set_level(spdlog::level::info);
+    spdlog::flush_on(spdlog::level::trace);
+
+    struct sigaction action;
+    memset(&action, 0, sizeof(action));
+    // The OpenOrbis header misspells its own sa_sigaction macro, go through the union.
+    action.__sa_handler.__sa_sigaction = FatalSignalHandler;
+    action.sa_flags = SA_SIGINFO;
+    for (int signalNumber : { SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT }) {
+        sigaction(signalNumber, &action, nullptr);
+    }
+    // Kernel (FreeBSD) signal numbers, not the musl/Linux ones from <signal.h>:
+    // SIGILL, SIGTRAP, SIGABRT, SIGFPE, SIGBUS, SIGSEGV, SIGSYS.
+    for (int signalNumber : { 4, 8, 10, 11, kHangDumpSignal }) {
+        const int result = sceKernelInstallExceptionHandler(signalNumber, KernelExceptionHandler);
+        if (result < 0) {
+            char line[96];
+            snprintf(line, sizeof(line), "[PS4] sceKernelInstallExceptionHandler(%d) failed: 0x%08X\n", signalNumber,
+                     (unsigned int)result);
+            BootLogRaw(line);
+        }
+    }
+    std::set_terminate(TerminateHandler);
+}
+
+// stat() used to report garbage sizes with the stock OpenOrbis headers (see ps4_fixups.h in the
+// build scripts). Compare it against lseek() on a file that is always there, so the log says
+// whether file sizes can be trusted on this console.
+void CheckFileSizes() {
+    const char* path = "/app0/2ship.o2r";
+    struct stat info;
+    memset(&info, 0, sizeof(info));
+    const int statResult = stat(path, &info);
+    long long seekSize = -1;
+    const int fd = open(path, O_RDONLY);
+    if (fd >= 0) {
+        seekSize = (long long)lseek(fd, 0, SEEK_END);
+        close(fd);
+    }
+    char line[200];
+    snprintf(line, sizeof(line), "[PS4] file size check on %s: stat %s, st_size %lld, lseek %lld -> %s\n", path,
+             statResult == 0 ? "ok" : "failed", (long long)info.st_size, seekSize,
+             (statResult == 0 && (long long)info.st_size == seekSize) ? "consistent" : "MISMATCH");
+    BootLogRaw(line);
+}
+
+} // namespace
+
+// Called by the audio mixer before every write to RAM (see 2s2h/mixer.c).
+extern "C" int Ps4_IsBadAudioDestination(const void* dest, size_t size, const char* what, void* caller,
+                                         void* callerOfCaller) {
+    const uintptr_t address = (uintptr_t)dest;
+    // Audio buffers live in the heap arena or on a thread stack, both far above 4 GiB; the
+    // executable and its globals sit below.
+    if (address >= 0x100000000ull || Ps4Heap_IsInArena(dest)) {
+        return 0;
+    }
+    static std::atomic<int> sReports{ 0 };
+    if (sReports.fetch_add(1) < 24) {
+        char line[256];
+        snprintf(line, sizeof(line),
+                 "[PS4] BAD AUDIO WRITE: %s to %p (%zu bytes, image offset %lx), called from code offset %lx, "
+                 "called from %lx\n",
+                 what, dest, size, (unsigned long)(address - (uintptr_t)&__text_start),
+                 (unsigned long)CodeOffset((uintptr_t)caller), (unsigned long)CodeOffset((uintptr_t)callerOfCaller));
+        BootLogRaw(line);
+    }
+    return 1;
+}
+
+namespace {
+
+void* GameThread(void*) {
+    uintptr_t top = 0;
+    // Not past this frame: the page above the top of the stack is not mapped.
+    sGameStackTop = (uintptr_t)&top;
+    BootLogRaw("[PS4] game thread started\n");
+    {
+        char line[96];
+        snprintf(line, sizeof(line), "[PS4] heap arena at %p, text at %p\n", Ps4Heap_GetArenaBase(),
+                 (void*)&__text_start);
+        BootLogRaw(line);
+    }
+    static char arg0[] = "2ship";
+    char* argv[] = { arg0, nullptr };
+    ship_main(1, argv);
+    BootLogRaw("[PS4] ship_main returned\n");
+    return nullptr;
+}
+
+void ReturnToSystem() {
+    size_t arenaSize = 0;
+    size_t inUse = 0;
+    size_t peak = 0;
+    Ps4Heap_GetStats(&arenaSize, &inUse, &peak);
+    printf("[PS4] heap arena %zu MiB, in use %zu MiB, peak %zu MiB\n", arenaSize >> 20, inUse >> 20, peak >> 20);
+    fflush(stdout);
+
+    // The orderly way for an application to quit back to the home screen.
+    sceSystemServiceLoadExec("exit", nullptr);
+}
+} // namespace
+
+int main(int argc, char* argv[]) {
+    if (mkdir(kDataDirectory, 0777) != 0 && errno != EEXIST) {
+        printf("[PS4] could not create %s: %s\n", kDataDirectory, strerror(errno));
+    }
+    if (chdir(kDataDirectory) != 0) {
+        printf("[PS4] could not change directory to %s: %s\n", kDataDirectory, strerror(errno));
+    }
+
+    InstallBootLog();
+    BootLogRaw("[PS4] 2 Ship 2 Harkinian boot\n");
+    CheckFileSizes();
+    CheckExceptions();
+
+    atexit(ReturnToSystem);
+
+    pthread_attr_t attributes;
+    pthread_attr_init(&attributes);
+    pthread_attr_setstacksize(&attributes, kGameThreadStackSize);
+
+    pthread_t thread;
+    const int result = pthread_create(&thread, &attributes, GameThread, nullptr);
+    pthread_attr_destroy(&attributes);
+    if (result == 0) {
+        sGameThread = thread;
+        pthread_t watchdog;
+        if (pthread_create(&watchdog, nullptr, HangWatchdog, nullptr) == 0) {
+            pthread_detach(watchdog);
+        }
+    }
+
+    if (result != 0) {
+        printf("[PS4] could not create the game thread (%d), running on the main thread\n", result);
+        GameThread(nullptr);
+    } else {
+        pthread_join(thread, nullptr);
+    }
+
+    return 0;
+}
+
+#endif // __PS4__
